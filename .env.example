# Optional for low-confidence relationship reasoning; bulk candidate extraction is local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Optional ordered failover pools, comma-separated. These override the single values above.
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Example fallback pool; use only model IDs enabled for your Google account.
# GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=
FRONTEND_ORIGINS=http://localhost:5173,https://your-frontend.example.com